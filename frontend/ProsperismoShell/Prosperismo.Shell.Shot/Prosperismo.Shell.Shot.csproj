<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Renders the real shell controls off-screen to PNG. This is the fidelity
    capture loop: the same controls the product draws, headless, so frames can
    be graded against the genuine PS5 reference footage.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ShellShot</AssemblyName>
    <RootNamespace>ShellShot</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Prosperismo.Shell\Prosperismo.Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
</Project>
