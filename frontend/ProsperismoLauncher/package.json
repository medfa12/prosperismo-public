{
  "name": "prosperismo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "windows": "node -r ./tools/rnw-powershell-shim.cjs ./node_modules/@react-native-community/cli/build/bin.js run-windows",
    "windows:bundle": "node -r ./tools/rnw-powershell-shim.cjs ./node_modules/@react-native-community/cli/build/bin.js bundle --platform windows --entry-file index.js --bundle-output windows/Prosperismo.Package/Bundle/index.windows.bundle --assets-dest windows/Prosperismo.Package/BundleAssets",
    "test:windows": "jest --config jest.config.windows.js",
    "preview:web": "vite --config web/vite.config.mts"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.83.4",
    "react-native-windows": "0.83.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-windows/find-dotnet-tools": "0.84.0",
    "@react-native/babel-preset": "0.83.4",
    "@react-native/eslint-config": "0.83.4",
    "@react-native/metro-config": "0.83.4",
    "@react-native/typescript-config": "0.83.4",
    "@rnx-kit/jest-preset": "^0.3.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "Prosperismo",
      "namespace": "Prosperismo",
      "template": "cpp-app"
    }
  },
  "codegenConfig": {
    "name": "ProsperismoShell",
    "type": "all",
    "jsSrcsDir": "src/bigPicture",
    "windows": {
      "namespace": "ProsperismoShellSpecs",
      "outputDirectory": "windows/Prosperismo/codegen",
      "generators": [
        "componentsWindows"
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
