<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProsperismoRendererSourceRoot Condition="'$(ProsperismoRendererSourceRoot)' == '' and '$(PROSPERISMO_RENDERER_SOURCE_ROOT)' != ''">$(PROSPERISMO_RENDERER_SOURCE_ROOT)</ProsperismoRendererSourceRoot>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ProsperismoRendererSourceRoot)\src\SharpEmu.Libs\SharpEmu.Libs.csproj')">
    <ProjectReference Include="$(ProsperismoRendererSourceRoot)\src\SharpEmu.Libs\SharpEmu.Libs.csproj" />
  </ItemGroup>

  <Target Name="RequireProsperismoRendererSource" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(ProsperismoRendererSourceRoot)\src\SharpEmu.Libs\SharpEmu.Libs.csproj')">
    <Error Text="Set ProsperismoRendererSourceRoot (or PROSPERISMO_RENDERER_SOURCE_ROOT) to the preserved renderer checkout." />
  </Target>
</Project>
